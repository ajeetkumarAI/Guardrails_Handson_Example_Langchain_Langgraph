# Copy this file to .env and fill in your own values.
# Nothing in this repository will work with real Gemini calls until you do,
# but every example and test also runs offline using a built-in stub model.

GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Optional: override the default Gemini model name
GUARDRAILS_MODEL_NAME=gemini-2.5-flash
